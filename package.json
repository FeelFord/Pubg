{
  "name": "battlegrounds-experience",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/smoke.mjs",
    "build:pages": "STATIC_EXPORT=true NEXT_PUBLIC_BASE_PATH=/Pubg SITE_URL=https://feelford.github.io npm run build",
    "deploy:pages": "npm run build:pages && node scripts/deploy-pages.mjs"
  },
  "dependencies": {
    "framer-motion": "^12.23.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0"
  }
}
